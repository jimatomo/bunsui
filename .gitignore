# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Virtual environments / uv
.venv/
engine/.venv/
.python-version-local

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
coverage.xml
*.cover

# Node / bun
node_modules/
web/**/node_modules/
web/apps/api/tests/.tmp-test/
dist/
.turbo/
*.tsbuildinfo

# Vite
web/apps/ui/dist/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Env / secrets
.env
.env.*
!.env.example

# Logs / local runtime data (keep .gitkeep)
*.log
examples/**/logs/*
!examples/**/logs/.gitkeep
examples/**/artifacts/*
!examples/**/artifacts/.gitkeep

# Local project meta DBs may be regenerated; keep sample sqlite for smoke demos
# Ignore ad-hoc projects at repo root
/my-project/

# Optional local tooling paths
.localstack/
.aws-sam/
